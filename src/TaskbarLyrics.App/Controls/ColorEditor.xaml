<UserControl x:Class="TaskbarLyrics.App.Controls.ColorEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:TaskbarLyrics.App.Controls" xmlns:t="clr-namespace:TaskbarLyrics.App.Themes" x:Name="Self" Width="38" Height="38">
    <UserControl.Resources>
        <Style x:Key="SpectrumSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Margin="6,0">
                    <Border Height="10" VerticalAlignment="Center" CornerRadius="5" Background="{TemplateBinding Background}" />
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="False">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="14" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="14" Height="14" Fill="White" Stroke="#FF545B66" StrokeThickness="1.5" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="EditorSurface" Height="38">
            <Button x:Name="SwatchButton" Click="OpenPicker" Width="38" Height="38" MinHeight="38" Padding="0" c:Motion.Hover="False" Background="{Binding Background, ElementName=Swatch}" AutomationProperties.Name="{Binding AccessibleName, ElementName=Self}">
                <Button.Template><ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" Width="38" Height="38">
                        <Ellipse x:Name="HoverRing" Width="36" Height="36" Stroke="{TemplateBinding Background}" StrokeThickness="1.5" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverRing" Property="Opacity" Value="1" /></Trigger>
                        
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverRing" Property="StrokeThickness" Value="3" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Button.Template>
                <Border x:Name="Swatch" Width="26" Height="26" CornerRadius="13" />
            </Button>
        </Border>
        <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=Self}" Placement="Custom" StaysOpen="False" AllowsTransparency="True" Opened="PickerOpened" Closed="PickerClosed">
            <Border c:KeyboardEditingOnly.Enabled="True" x:Name="PickerSurface" Width="280" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="14,14,0,14">
                <ScrollViewer Style="{DynamicResource AppScrollViewer}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                    <StackPanel x:Name="PickerContent" Margin="5,0">
                        <Border CornerRadius="{DynamicResource AppearanceControlCornerRadius}" t:RoundedClip.Enabled="True">
                            <c:ColorSpectrum x:Name="Spectrum" Height="160" SelectionChanged="SpectrumChanged" AutomationProperties.Name="饱和度与明度色板" />
                        </Border>
                        <Slider x:Name="Hue" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15" IsMoveToPointEnabled="True" Style="{StaticResource SpectrumSlider}" Margin="0,10,0,4" ValueChanged="PaletteChanged" AutomationProperties.Name="色相">
                            <Slider.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Red" Offset="0"/><GradientStop Color="Yellow" Offset="0.1667"/><GradientStop Color="Lime" Offset="0.3333"/><GradientStop Color="Cyan" Offset="0.5"/><GradientStop Color="Blue" Offset="0.6667"/><GradientStop Color="Magenta" Offset="0.8333"/><GradientStop Color="Red" Offset="1"/></LinearGradientBrush></Slider.Background>
                        </Slider>
                        <TextBlock x:Name="AlphaLabel" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        <Slider x:Name="Alpha" Maximum="255" SmallChange="1" LargeChange="16" IsMoveToPointEnabled="True" Style="{StaticResource SpectrumSlider}" ValueChanged="PaletteChanged" AutomationProperties.Name="不透明度" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="颜色值" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <TextBox x:Name="HexInput" Grid.Column="1" Width="112" Height="32" BorderThickness="0" Background="{DynamicResource SurfaceAltBrush}" VerticalContentAlignment="Center" Padding="12,0" KeyDown="HexKey" LostKeyboardFocus="HexFocus" AutomationProperties.Name="颜色值，支持 RGB 或 ARGB">
                                <TextBox.Template><ControlTemplate TargetType="TextBox">
                                    <Border x:Name="ValueSurface" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="{TemplateBinding Padding}">
                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ValueSurface" Property="Background" Value="{DynamicResource PlaybackHoverBrush}" /></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ValueSurface" Property="Background" Value="{DynamicResource PlaybackHoverBrush}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></TextBox.Template>
                            </TextBox>
                        </Grid>
                        <TextBlock x:Name="Error" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" AutomationProperties.LiveSetting="Assertive" />
                        <StackPanel x:Name="RecentSection" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="最近使用" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                            <ItemsControl x:Name="RecentItems" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:RecentColorPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Click="RecentColorClicked" Tag="{Binding}" Background="{Binding}" Margin="0,2" Width="38" Height="38" Padding="0" AutomationProperties.Name="{Binding}">
                                        <Button.Template><ControlTemplate TargetType="Button">
                                            <Grid x:Name="Root" Background="Transparent"><Ellipse x:Name="RecentRing" Width="36" Height="36" Stroke="{TemplateBinding Background}" StrokeThickness="1.5" Opacity="0" /><Ellipse x:Name="RecentSurface" Width="28" Height="28" Fill="{TemplateBinding Background}" /></Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RecentRing" Property="Opacity" Value="1" /></Trigger>
                                                
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="RecentRing" Property="StrokeThickness" Value="3" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Button.Template>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
