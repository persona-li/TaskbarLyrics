<UserControl x:Class="TaskbarLyrics.App.Controls.LyricsPreview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:TaskbarLyrics.App.Controls" xmlns:theme="clr-namespace:TaskbarLyrics.App.Themes" Height="150">
    <UserControl.Resources>
        <Style x:Key="PreviewSourceItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Padding" Value="4,7" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Margin="3,1">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                        <Border x:Name="SelectionOutline" BorderBrush="{DynamicResource SelectionOutlineBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource PlaybackHoverBrush}" /><Setter TargetName="SelectionOutline" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource PlaybackPressedBrush}" /><Setter TargetName="SelectionOutline" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="PreviewSourceChoice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PreviewSourceItem}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" />
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" CornerRadius="{DynamicResource AppearanceControlCornerRadius}">
                                    <Path x:Name="DisclosureArrow" Stroke="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center" Data="M3,1 L7,5 L3,9" Width="10" Height="10" Stretch="None" RenderTransformOrigin="0.5,0.5" c:Motion.DisclosureOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Border>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,0,18,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Border BorderBrush="{DynamicResource SelectionOutlineBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" c:Motion.PopupOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Grid c:KeyboardEditingOnly.Enabled="True" Width="68" Margin="0,4,0,0">
                                <Border x:Name="PopupSurface" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="0,4">
                                    <ScrollViewer Style="{DynamicResource AppScrollViewer}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False" MaxHeight="200">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="PreviewBackgroundSegment" TargetType="RadioButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid><Border x:Name="Segment" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border><Border x:Name="SegmentOutline" BorderBrush="{DynamicResource SelectionOutlineBrush}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False" /></Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource PlaybackHoverBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="Transparent" />
                                <Setter TargetName="SegmentOutline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PreviewLayout">
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="PreviewToolbar">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="预览" Style="{StaticResource CaptionText}" FontSize="14" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="SourceChoice" SelectedIndex="0" Width="78" Style="{StaticResource PreviewSourceChoice}" Margin="0,0,8,0" SelectionChanged="SourceChanged" AutomationProperties.Name="预览来源">
                    <ComboBoxItem Content="示例" />
                    <ComboBoxItem Content="当前歌曲" />
                </ComboBox>
                <Border x:Name="BackgroundSegmentsContainer" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="0" Margin="0,0,8,0" theme:RoundedClip.Enabled="True">
                    <Grid>
                    <Border x:Name="BackgroundIndicator" Width="48" HorizontalAlignment="Left" Background="{DynamicResource PlaybackPressedBrush}" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform x:Name="BackgroundIndicatorTranslate" X="48" /></Border.RenderTransform></Border>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LightBackgroundButton" Content="浅色" Tag="Light" GroupName="PreviewBackground" Style="{StaticResource PreviewBackgroundSegment}" Checked="BackgroundSelected" AutomationProperties.Name="使用浅色预览背景" />
                        <RadioButton x:Name="DarkBackgroundButton" Content="深色" Tag="Dark" GroupName="PreviewBackground" Style="{StaticResource PreviewBackgroundSegment}" IsChecked="True" Checked="BackgroundSelected" AutomationProperties.Name="使用深色预览背景" />
                    </StackPanel>
                    </Grid>
                </Border>
                <Button x:Name="PlayButton" FontFamily="Segoe MDL2 Assets" Content="" Click="PlayClick" Width="32" Padding="0" Style="{StaticResource GhostButton}" />
            </StackPanel>
        </Grid>
        <Border x:Name="TaskbarSurface" Grid.Row="2" Background="#242426" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="20,12">
            <Grid x:Name="PreviewViewport" ClipToBounds="True" SizeChanged="PreviewSizeChanged">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <c:KaraokeTextControl x:Name="Karaoke" Height="48" Width="320">
                        <c:KaraokeTextControl.LayoutTransform><ScaleTransform ScaleX="1.15" ScaleY="1.15" /></c:KaraokeTextControl.LayoutTransform>
                    </c:KaraokeTextControl>
                </Viewbox>
                <TextBlock x:Name="PreviewHint" Text="暂无播放" Foreground="#BFBFC5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
