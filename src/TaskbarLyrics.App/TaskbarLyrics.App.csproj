<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
    <RootNamespace>TaskbarLyrics.App</RootNamespace>
    <AssemblyName>TaskbarLyrics.App</AssemblyName>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\Release\</PublishDir>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Windows 11 taskbar lyrics for QQ Music</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskbarLyrics.Core\TaskbarLyrics.Core.csproj" />
    <ProjectReference Include="..\TaskbarLyrics.Gsmtc\TaskbarLyrics.Gsmtc.csproj" />
    <ProjectReference Include="..\TaskbarLyrics.QQMusic\TaskbarLyrics.QQMusic.csproj" />
    <ProjectReference Include="..\TaskbarLyrics.Cache\TaskbarLyrics.Cache.csproj" />
    <ProjectReference Include="..\TaskbarLyrics.Windows\TaskbarLyrics.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\app.ico" />
    <Resource Include="Assets\Icons\tray.ico" />
    <Resource Include="Assets\Icons\logo-256.png" />
  </ItemGroup>

</Project>
