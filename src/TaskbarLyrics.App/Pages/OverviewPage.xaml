<UserControl x:Class="TaskbarLyrics.App.Pages.OverviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:TaskbarLyrics.App.Controls" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <Style x:Key="PlaybackAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <c:AttentionPulse x:Name="AttentionLayer" IsActive="{Binding State.NeedsAttention}" ReduceMotion="{Binding ReduceMotion}" Background="{DynamicResource PlaybackHoverBrush}" BorderBrush="{DynamicResource SelectionOutlineBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" />
                                <Border x:Name="HoverLayer" Background="{DynamicResource PlaybackHoverBrush}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="PressLayer" Background="{DynamicResource PlaybackPressedBrush}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter x:Name="ContentHost" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="PressLayer" Property="Opacity" Value="1" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="PlaybackViewport" SizeChanged="ViewportSizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
        <!-- The outer ScrollViewer already reserves the shared 14 DIP right gutter. -->
        <Grid x:Name="PlaybackLayout" Margin="28,28,14,18" MinHeight="420">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" Text="{Binding OverviewPlaybackLabel}" FontSize="26" FontWeight="SemiBold" Margin="4,0,0,18" />
            <Border x:Name="PlaybackCard" Grid.Row="1" VerticalAlignment="Stretch" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="24,26,24,24">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid x:Name="CardHeader" SizeChanged="HeaderSizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel x:Name="SongDetails" c:Motion.ChangeKey="{Binding State.TrackVisualKey}" Margin="0,0,18,0">
                            <TextBlock Text="{Binding State.Title}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" MaxHeight="76" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding State.Artist}" FontSize="17" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding State.Album}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <WrapPanel x:Name="Actions" Grid.Column="1" VerticalAlignment="Top" Margin="0,0,0,0">
                            <Button Content="选择歌词" Command="{Binding RematchCommand}" Style="{StaticResource PlaybackAction}" Margin="0" />
                        </WrapPanel>
                    </Grid>
                    <Grid x:Name="LyricFit" c:Motion.ChangeKey="{Binding State.TrackVisualKey}" Grid.Row="1" Margin="8,16,8,12">
                        <c:ScrollingLyrics x:Name="CurrentLyric" State="{Binding State}" Config="{Binding PreviewConfig}"
                            FontFamily="{StaticResource PlaybackLyricFont}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                            AutomationProperties.Name="滚动歌词">
                            <c:ScrollingLyrics.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00FFFFFF" Offset="0" /><GradientStop Color="White" Offset="0.12" />
                                    <GradientStop Color="White" Offset="0.86" /><GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </c:ScrollingLyrics.OpacityMask>
                        </c:ScrollingLyrics>

                    </Grid>
                    <StackPanel Grid.Row="2">
                        <c:PlaybackSeekSlider x:Name="SongProgress" PositionSeconds="{Binding PlaybackPositionSeconds}" DurationSeconds="{Binding PlaybackDurationSeconds}" TrackKey="{Binding State.EditContext}" SeekCommand="{Binding SeekPlaybackCommand}" IsSeekEnabled="{Binding CanSeekPlayback}" IsPlaying="{Binding State.IsPlaying}" SmoothPlayback="True" Style="{StaticResource HoverPlaybackProgress}" AutomationProperties.Name="歌曲播放进度" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="PreviousTrackButton" Command="{Binding PreviousTrackCommand}" IsEnabled="{Binding CanSkipPrevious}" Style="{StaticResource MediaTransportButton}" AutomationProperties.Name="上一首" ContentTemplate="{StaticResource MediaPreviousIcon}" />
                                <Button x:Name="PlaybackToggleButton" Command="{Binding TogglePlaybackCommand}" IsEnabled="{Binding CanTogglePlayback}" Style="{StaticResource MediaTransportButton}" Content="{Binding PlaybackButtonIsPlaying}" ContentTemplate="{StaticResource MediaPlayPauseIcon}" AutomationProperties.Name="{Binding PlaybackButtonLabel}" />
                                <Button x:Name="NextTrackButton" Command="{Binding NextTrackCommand}" IsEnabled="{Binding CanSkipNext}" Style="{StaticResource MediaTransportButton}" AutomationProperties.Name="下一首" ContentTemplate="{StaticResource MediaNextIcon}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding State.TimeLabel}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                        <TextBlock Text="{Binding State.StatusHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding State.HasAttentionHint, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
