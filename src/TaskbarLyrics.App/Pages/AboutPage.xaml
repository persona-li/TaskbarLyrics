<UserControl x:Class="TaskbarLyrics.App.Pages.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:TaskbarLyrics.App.Controls" FontFamily="{StaticResource AppFont}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="28,28,28,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="关于" FontSize="26" FontWeight="SemiBold" Margin="4,0,0,18" />
        <Border x:Name="AboutCard" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" VerticalAlignment="Top">
            <ScrollViewer x:Name="AboutScroll" Style="{StaticResource AppScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,24,0,18">
                <StackPanel x:Name="AboutContent" Margin="12,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Style="{StaticResource AppLogoImage}" Width="56" Height="56" Margin="0,0,18,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="TaskbarLyrics" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="QQ 音乐任务栏歌词" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,22,0,12" />
                    <Grid MinHeight="44">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="版本" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock x:Name="VersionValue" Grid.Column="1" Text="{Binding Version}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid MinHeight="44">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="歌词来源" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="QQ 音乐" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
