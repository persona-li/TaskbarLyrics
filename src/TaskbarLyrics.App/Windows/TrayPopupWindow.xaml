<Window c:KeyboardEditingOnly.Enabled="True" x:Class="TaskbarLyrics.App.Windows.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:TaskbarLyrics.App.Controls"
        Title="TaskbarLyrics Menu"
        Width="228"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        Focusable="True"
        FontFamily="{DynamicResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!--
      Compact flat context menu (Wallpaper Engine-like):
      no brand header, tight rows, soft corner + light shadow.
    -->
    <Window.Resources>
        <Style x:Key="CtxItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CtxDanger" TargetType="Button" BasedOn="{StaticResource CtxItem}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <Style x:Key="CtxSep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Margin" Value="8,4"/>
        </Style>
    </Window.Resources>

    <!-- Outer margin = shadow bleed only -->
    <Border x:Name="TraySurface" Margin="8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.28" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- Toggle: checkmark + label (flat, no switch chrome) -->
            <Button x:Name="BtnToggle" Style="{StaticResource CtxItem}" Click="BtnToggle_OnClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ToggleCheck"
                               Text=""
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="显示任务栏歌词"
                               VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Grid>
            </Button>

            <Border Style="{StaticResource CtxSep}"/>

            <Button Style="{StaticResource CtxItem}" Click="BtnSettings_OnClick">
                <TextBlock Text="打开设置"/>
            </Button>
            <Button Style="{StaticResource CtxItem}" Click="BtnReload_OnClick">
                <TextBlock Text="重新加载当前歌词"/>
            </Button>
            <Button Style="{StaticResource CtxItem}" Click="BtnRematch_OnClick">
                <TextBlock Text="重新匹配当前歌词"/>
            </Button>

            <Border Style="{StaticResource CtxSep}"/>

            <Button Style="{StaticResource CtxItem}" Click="BtnCache_OnClick">
                <TextBlock Text="打开缓存目录"/>
            </Button>
            <Button Style="{StaticResource CtxDanger}" Click="BtnExit_OnClick">
                <TextBlock Text="退出"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
