<Window c:KeyboardEditingOnly.Enabled="True" x:Class="TaskbarLyrics.App.Windows.ModernDialogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:TaskbarLyrics.App.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Width="500" SizeToContent="Height" MinHeight="220" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="DialogSurface" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="16,0">
                <TextBlock x:Name="DialogTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
            <Grid Grid.Row="1" Margin="22,22,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="GlyphPlate" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PlaybackHoverBrush}" VerticalAlignment="Top">
                        <TextBlock x:Name="Glyph" Text="i" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ScrollViewer x:Name="MessageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                        <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" FontSize="14" LineHeight="22" />
                    </ScrollViewer>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}" Width="88" Margin="0,0,10,0" Click="Cancel_OnClick" />
                    <Button x:Name="ConfirmButton" Content="确定" Style="{StaticResource SoftAccentButton}" MinWidth="96" Padding="16,0" Click="Confirm_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>