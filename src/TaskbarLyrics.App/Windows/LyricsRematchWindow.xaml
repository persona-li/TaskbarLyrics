<Window c:KeyboardEditingOnly.Enabled="True" x:Class="TaskbarLyrics.App.Windows.LyricsRematchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:TaskbarLyrics.App.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="选择歌词" Width="720" Height="640" MinWidth="580" MinHeight="480" WindowStartupLocation="CenterOwner" WindowStyle="None" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" Icon="pack://application:,,,/TaskbarLyrics.App;component/Assets/Icons/app.ico" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="RematchAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="c:Motion.Hover" Value="False" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource PlaybackHoverBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource PlaybackPressedBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="RematchApply" TargetType="Button" BasedOn="{StaticResource RematchAction}">
            <Setter Property="Background" Value="{DynamicResource PlaybackHoverBrush}" />
        </Style>
        <Style x:Key="RematchSearch" TargetType="TextBox" BasedOn="{StaticResource CompactTextBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PlaybackHoverBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource PlaybackHoverBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="RematchSurface" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource ChromeBrush}" CornerRadius="10,10,0,0" Padding="20,0,6,0">
                <Grid>
                    <TextBlock Text="选择歌词" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource TitleBarButton}" Content="" Click="CloseClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="关闭版本选择" />
                </Grid>
            </Border>
            <Grid x:Name="DialogContent" Focusable="True" Grid.Row="1" Margin="28,24,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" c:OverflowHint.Enabled="True" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="0,8,0,22" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,16" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Style="{StaticResource RematchSearch}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Height="36" MinHeight="36" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="歌名或歌手" />
                    <Button x:Name="SearchButton" Grid.Column="1" Command="{Binding SearchCommand}" Style="{StaticResource RematchAction}" Height="36" Width="36" MinHeight="36" Padding="0" ToolTip="搜索" AutomationProperties.Name="搜索">
                        <Path Data="M 7,1 A 6,6 0 1 1 6.99,1 M 11.5,11.5 L 16,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                </Grid>
                <StackPanel Grid.Row="2">
                    <DockPanel Margin="0,0,0,12" Visibility="{Binding IsStale, Converter={StaticResource BoolVisibility}}">
                        <Button DockPanel.Dock="Right" Content="匹配当前歌曲" Command="{Binding RestartCommand}" Style="{StaticResource ActionLink}" />
                        <TextBlock Text="歌曲已切换" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12" MaxHeight="72" ToolTip="{Binding Error}" c:OverflowHint.Enabled="True" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
                <Grid Grid.Row="3">
                    <ListBox x:Name="CandidateList" ItemsSource="{Binding Candidates}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource CandidateListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="歌词版本">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" c:OverflowHint.Enabled="True" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="0,5,0,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" c:OverflowHint.Enabled="True" />
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding Confidence}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" />
                </Grid>
                <DockPanel Grid.Row="4" Margin="0,12,0,16">
                    <Button DockPanel.Dock="Right" Content="更多" Command="{Binding MoreCommand}" Style="{StaticResource GhostButton}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Content="取消" Width="64" Padding="6,0" Click="CloseClick" Style="{StaticResource RematchAction}" Margin="0,0,8,0" />
                        <Button x:Name="ApplyButton" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" Style="{StaticResource RematchApply}" Width="64" Padding="6,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
