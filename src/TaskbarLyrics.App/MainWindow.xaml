<Window x:Class="TaskbarLyrics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TaskbarLyrics.App.Controls"
        Title="TaskbarLyrics"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        Width="600"
        Height="48"
        Left="0"
        Top="0">
    <!-- Fully transparent: no Border background, no board. Taskbar shows through. -->
    <Grid x:Name="PlacementHost" Background="Transparent" IsHitTestVisible="False">
        <controls:KaraokeTextControl x:Name="Karaoke"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Margin="8,0"/>
    </Grid>
</Window>
