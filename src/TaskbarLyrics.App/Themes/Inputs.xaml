<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TaskbarLyrics.App.Themes" xmlns:c="clr-namespace:TaskbarLyrics.App.Controls">
    <!-- Compact numeric fields (settings sliders / int rows). -->
    <Style x:Key="CompactTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PlaybackIndicatorBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PlaybackIndicatorBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="SelectionOutline" BorderBrush="{DynamicResource SelectionOutlineBrush}" BorderThickness="2" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Margin="3,1" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PlaybackHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PlaybackPressedBrush}" />
                            <Setter TargetName="SelectionOutline" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="c:ComboBoxInteraction.OpenOnClick" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" />
                        <Grid Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="ContentSite" Panel.ZIndex="1" Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextBlock.TextAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" />
                            <TextBox x:Name="PART_EditableTextBox" Panel.ZIndex="2" TextAlignment="Center" VerticalContentAlignment="Center" Margin="4,0" Visibility="Hidden" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="4,0" Foreground="{TemplateBinding Foreground}" IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <!-- Full-height hit area; chevron path centered -->
                            <ToggleButton x:Name="DropDownToggle" Grid.ColumnSpan="2" Panel.ZIndex="0" Background="Transparent" BorderThickness="0" Focusable="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path x:Name="DisclosureArrow" Stroke="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Data="M3,1 L7,5 L3,9" Width="10" Height="10" Stretch="None" RenderTransformOrigin="0.5,0.5" c:Motion.DisclosureOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                        <!-- Keep animation clipping separate from the rounded menu surface. -->
                        <Popup x:Name="PART_Popup" c:Motion.PopupOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Grid c:KeyboardEditingOnly.Enabled="True" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0">
                            <Border x:Name="PopupSurface" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="4" MaxHeight="320" local:RoundedClip.Enabled="True">
                                <ScrollViewer Style="{DynamicResource AppScrollViewer}" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False" Padding="0">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEditable" Value="True" /><Condition Property="IsReadOnly" Value="False" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" /></MultiTrigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEditable" Value="True" /><Condition Property="IsReadOnly" Value="False" /><Condition Property="IsKeyboardFocusWithin" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PlaybackIndicatorBrush}" /></MultiTrigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Settings booleans use a rounded capsule switch with a circular floating thumb. -->
    <Style TargetType="CheckBox">
        <Setter Property="c:InteractionMotion.Enabled" Value="True" />
        <Setter Property="c:Motion.Switch" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Margin" Value="0,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel LastChildFill="True">
                        <Border x:Name="Track" DockPanel.Dock="Right" Width="42" Height="24" Margin="16,0,0,0" VerticalAlignment="Center" Background="{DynamicResource SurfacePressedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="12">
                            <Grid>
                                <Border x:Name="SwitchFill" Background="{DynamicResource PlaybackIndicatorBrush}" CornerRadius="12" Opacity="0" IsHitTestVisible="False" />
                                <Ellipse x:Name="Thumb" Width="20" Height="20" VerticalAlignment="Center" Fill="{DynamicResource SidebarThumbBrush}" HorizontalAlignment="Left" Margin="2">
                                    <Ellipse.Effect><DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="3" ShadowDepth="1" Direction="270" /></Ellipse.Effect>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource SidebarThumbBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
      Modern slider.
      Track.DecreaseRepeatButton width ends at Thumb.Left (WPF Track layout).
      Full CornerRadius on fill drew a capsule tip left of the thumb → "blue round end + separate thumb".
      Fix: left-only radii + extend fill under thumb center via negative right margin (half thumb).
    -->
    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
        <Setter Property="Foreground" Value="{DynamicResource PlaybackIndicatorBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" MinHeight="28" Margin="8,0">
                        <!-- Inactive track: full pill -->
                        <Border x:Name="TrackBackground" Height="8" CornerRadius="4" Background="{DynamicResource SurfacePressedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Height="8" VerticalAlignment="Center" Focusable="False" IsTabStop="False" OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <!--
                                              Left radii only (4,0,0,4). Right is flat under the thumb.
                                              Margin right = -ThumbWidth/2 so fill reaches Thumb.CenterX;
                                              Thumb paints above and covers the seam.
                                            -->
                                            <Border Background="{DynamicResource PlaybackIndicatorBrush}" CornerRadius="4,0,0,4" Height="8" Margin="0,0,-9,0" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18" VerticalAlignment="Center" Panel.ZIndex="1">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="18" Height="18">
                                                <Ellipse Width="18" Height="18" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource PlaybackIndicatorBrush}" StrokeThickness="2" SnapsToDevicePixels="True">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.22" Color="#000000" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource PlaybackIndicatorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Height="8" VerticalAlignment="Center" Focusable="False" IsTabStop="False" OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Height="8" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
