<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Legacy aggregator. App.xaml now merges the theme dictionaries flatly so
      StaticResource lookups (especially TrayMenuButton) do not depend on nested MDs.
      Kept for any leftover Source references.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Cards.xaml"/>
        <ResourceDictionary Source="Buttons.xaml"/>
        <ResourceDictionary Source="Inputs.xaml"/>
        <ResourceDictionary Source="Navigation.xaml"/>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
