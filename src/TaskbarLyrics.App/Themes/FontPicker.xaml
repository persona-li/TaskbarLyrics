<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:TaskbarLyrics.App.Controls">
    <Style x:Key="FontPickerItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="ToolTipService.IsEnabled" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <c:FontNameMarquee x:Name="LabelViewport">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource TextPrimaryBrush}"  />
                            </c:FontNameMarquee>
                        </Border>
                        <Border x:Name="SelectionOutline" BorderBrush="{DynamicResource SelectionOutlineBrush}" BorderThickness="2" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Margin="3,1" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:FontPickerItem.IsActive" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PlaybackHoverBrush}" />
                            <Setter TargetName="LabelViewport" Property="IsActive" Value="True" />
                            <Setter TargetName="SelectionOutline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        
                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FontPickerStyle" TargetType="{x:Type c:FontPicker}">
        <Setter Property="c:ComboBoxInteraction.OpenOnClick" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:FontPicker}">
                    <Grid>
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" />
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" Background="Transparent" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" CornerRadius="{DynamicResource AppearanceControlCornerRadius}">
                                        <Path x:Name="DisclosureArrow" Stroke="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M3,1 L7,5 L3,9" Width="10" Height="10" Stretch="None" RenderTransformOrigin="0.5,0.5" c:Motion.DisclosureOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock x:Name="FontDisplay" Text="{TemplateBinding Text}" Margin="8,0,32,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                        <c:FontPickerTextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="8,0,32,0" VerticalContentAlignment="Center" TextAlignment="Left" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent" VerticalAlignment="Center" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </c:FontPickerTextBox>
                        <Popup x:Name="PART_Popup" c:Motion.PopupOpen="{TemplateBinding IsDropDownOpen}" Placement="Custom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border c:KeyboardEditingOnly.Enabled="True" x:Name="PopupSurface" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Padding="4" MaxHeight="320">
                                <ScrollViewer Style="{DynamicResource AppScrollViewer}" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False" Padding="0">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True"><Setter TargetName="FontDisplay" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" /></Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEditable" Value="True" /><Condition Property="IsReadOnly" Value="False" /><Condition SourceName="DropDownToggle" Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Root" Property="Background" Value="{DynamicResource PlaybackHoverBrush}" /></MultiTrigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEditable" Value="True" /><Condition Property="IsReadOnly" Value="False" /><Condition SourceName="PART_EditableTextBox" Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Root" Property="Background" Value="{DynamicResource PlaybackHoverBrush}" /></MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
