<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark-first Fluent-inspired palette -->
    <Color x:Key="BgColor">#FF14161A</Color>
    <Color x:Key="SurfaceColor">#FF1E2228</Color>
    <Color x:Key="SurfaceAltColor">#FF272C34</Color>
    <Color x:Key="SurfaceHoverColor">#FF313843</Color>
    <Color x:Key="BorderColor">#FF3A414D</Color>
    <Color x:Key="BorderSubtleColor">#FF2A3038</Color>
    <Color x:Key="TextPrimaryColor">#FFF2F4F7</Color>
    <Color x:Key="TextSecondaryColor">#FFB0B7C3</Color>
    <Color x:Key="TextMutedColor">#FF7A8290</Color>
