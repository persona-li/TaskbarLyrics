<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:TaskbarLyrics.App.Controls">
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="c:InteractionMotion.Enabled" Value="True" />
        <Setter Property="c:Motion.Hover" Value="True" />
        <Setter Property="c:Motion.PressedBrush" Value="{DynamicResource PlaybackPressedBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="c:Motion.HoverBrush" Value="{DynamicResource PlaybackHoverBrush}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="HoverLayer" Background="{Binding (c:Motion.HoverBrush), RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressLayer" Background="{Binding (c:Motion.PressedBrush), RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="ContentHost" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextBlock.TextAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressLayer" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="c:Motion.HoverBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="c:Motion.PressedBrush" Value="{DynamicResource AccentPressedBrush}" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="SoftAccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{DynamicResource PlaybackHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="c:Motion.HoverBrush" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="c:Motion.PressedBrush" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="TrayMenuButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />
</ResourceDictionary>