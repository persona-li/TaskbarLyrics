<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:TaskbarLyrics.App.Controls">
    <!-- All transport icons share an 18 DIP canvas and 12 DIP ink height.
         The filled shapes avoid mixing font glyph baselines with vector icons. -->
    <Geometry x:Key="MediaPreviousGeometry">M3,3 L5,3 L5,15 L3,15 Z M15,3 L7,9 L15,15 Z</Geometry>
    <Geometry x:Key="MediaNextGeometry">M3,3 L11,9 L3,15 Z M13,3 L15,3 L15,15 L13,15 Z</Geometry>
    <Geometry x:Key="MediaPlayGeometry">M5,3 L16,9 L5,15 Z</Geometry>
    <Geometry x:Key="MediaPauseGeometry">M5,3 L8,3 L8,15 L5,15 Z M10,3 L13,3 L13,15 L10,15 Z</Geometry>
    <DataTemplate x:Key="MediaPreviousIcon">
        <Path x:Name="TransportIcon" Width="18" Height="18" Stretch="None" Data="{StaticResource MediaPreviousGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </DataTemplate>
    <DataTemplate x:Key="MediaNextIcon">
        <Path x:Name="TransportIcon" Width="18" Height="18" Stretch="None" Data="{StaticResource MediaNextGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </DataTemplate>
    <DataTemplate x:Key="MediaPlayPauseIcon">
        <Path x:Name="TransportIcon" Width="18" Height="18" Stretch="None" Data="{StaticResource MediaPlayGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="True"><Setter TargetName="TransportIcon" Property="Data" Value="{StaticResource MediaPauseGeometry}" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="MediaTransportButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="c:Motion.Hover" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource AppearanceControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PlaybackHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PlaybackPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsPlaybackControlBusy}" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="1" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HoverPlaybackProgress" TargetType="c:PlaybackSeekSlider">
        <Setter Property="Foreground" Value="{DynamicResource PlaybackIndicatorBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:PlaybackSeekSlider">
                    <Grid Background="Transparent">
                        <Border Height="5" CornerRadius="2.5" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False" OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="5" CornerRadius="2.5" Margin="0,0,-6,0" VerticalAlignment="Center"
                                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type c:PlaybackSeekSlider}}}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="ProgressThumb" Width="12" Height="24" Opacity="0">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type c:PlaybackSeekSlider}}}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False" OverridesDefaultStyle="True">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="CanSeek" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="ProgressThumb" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="CanSeek" Value="True" /><Condition Property="IsMouseCaptureWithin" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="ProgressThumb" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <Trigger Property="CanSeek" Value="True"><Setter Property="Cursor" Value="Hand" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
